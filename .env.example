# In Vercel unter Settings → Environment Variables eintragen (nicht ins Repo committen).
NEXT_PUBLIC_SUPABASE_URL=https://twhudfzskximjgghming.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Optional: anderes Claude-Modell für die Agenten
ANTHROPIC_MODEL=claude-sonnet-4-5
# Bild-Agent (open.higgsfield.ai → API keys): KEY_ID:KEY_SECRET in einer Zeile
HIGGSFIELD_KEY=
# Optional: Bildmodell und Preis je Bild für die Kostenrechnung
HIGGSFIELD_MODEL=ideogram/v4.0
HIGGSFIELD_PREIS_EUR=0.03

# ---------- Buchungs-Agent (Seite /buchungen) ----------
# Server-Schlüssel aus Supabase → Project Settings → API (service_role). Nur in Vercel, nie im Browser.
SUPABASE_SERVICE_ROLE_KEY=
# Öffentliche Adresse der App (für Bild-Links in Druck-PDFs), z. B. https://lokalpilot.vercel.app
APP_URL=
# Vercel Cron: beliebige lange Zufallszeichenkette
CRON_SECRET=
# E-Mail über Resend (resend.com): Domain verifizieren, Empfang (MX) aktivieren, Webhook email.received → /api/buchung/mail
RESEND_API_KEY=
BUCHUNG_MAIL_FROM=anzeigen@modernisieren24.de
RESEND_WEBHOOK_SECRET=
# Direktbuchung in Online-Shops: Cloud-Browser von browserbase.com
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=eu-central-1
# Optional: Modell + Computer-Use-Version für den Browser-Agenten (20250124 oder 20251124 für neuere Modelle)
BROWSER_MODEL=
BROWSER_TOOL_VERSION=20250124
# Optional: Login-Adresse für neu angelegte Shop-Konten (Standard: BUCHUNG_MAIL_FROM)
BUCHUNG_SHOP_LOGIN=
